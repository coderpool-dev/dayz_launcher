# Значения по умолчанию. Реальные настройки сервера — в .env.local (не хранится в git):
#   APP_ENV=prod
#   APP_SECRET=<случайная строка>
#   BATTLEMETRICS_TOKEN=...
#   SERVERS_REFRESH_KEY=...
#
# Порядок загрузки: .env → .env.local → .env.$APP_ENV → .env.$APP_ENV.local; переменные окружения важнее файлов.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# SQLite: один файл в var/, отдельный сервер БД не нужен.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> app ###
# Токен BattleMetrics API (нужна подписка). Пусто — источник пропускается.
BATTLEMETRICS_TOKEN=
# Ключ для принудительного обновления списка: /api/servers?refresh=1&key=<ключ>. Пусто — отключено.
SERVERS_REFRESH_KEY=
# Сколько дней хранить статистику по IP (команда app:stats:prune).
STATS_RETENTION_DAYS=180
###< app ###
