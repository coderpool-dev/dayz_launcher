{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Статистика лаунчера{% endblock %}

{% block main %}
    <link rel="stylesheet" href="{{ asset('admin/dashboard.css') }}">

    <div class="stat-grid">
        <div class="stat-card online">
            <div class="value">{{ onlineNow }}</div>
            <div class="label">Онлайн сейчас (за {{ onlineWindow }} мин)</div>
        </div>
        <div class="stat-card">
            <div class="value">{{ uniqueIpsToday }}</div>
            <div class="label">Уникальных IP сегодня</div>
        </div>
        <div class="stat-card">
            <div class="value">{{ playsToday }}</div>
            <div class="label">Нажатий «Играть» сегодня</div>
        </div>
        <div class="stat-card">
            <div class="value">{{ totalInstalls }}</div>
            <div class="label">Установок всего</div>
        </div>
    </div>

    {% set t = traffic %}
    <div class="panel traffic" id="traffic">
        <h3>Активность сайта
            <span class="muted">
                {% for d, label in {1: 'сегодня', 7: '7 дней', 30: '30 дней', 90: '90 дней', 365: 'год'} %}
                    {% if t.days == d %}<b>{{ label }}</b>{% else %}<a href="?days={{ d }}#traffic">{{ label }}</a>{% endif %}{% if not loop.last %} · {% endif %}
                {% endfor %}
            </span>
        </h3>
        <div class="stat-grid">
            <div class="stat-card"><div class="value">{{ t.totals.visitors }}</div><div class="label">Посетители</div></div>
            <div class="stat-card"><div class="value">{{ t.totals.visits }}</div><div class="label">Визиты</div></div>
            <div class="stat-card"><div class="value">{{ t.totals.downloads }}</div><div class="label">Визитов со скачиванием{% if t.totals.visits > 0 %} · конверсия {{ (t.totals.convertedVisits / t.totals.visits * 100)|round(1) }}%{% endif %}</div></div>
            <div class="stat-card"><div class="value">{{ t.totals.installs }}</div><div class="label">Новых установок</div></div>
        </div>

        <section class="traffic-activity" aria-label="График активности сайта" data-traffic-activity>
            <script type="application/json" data-traffic-data>{{ {series: t.series, sources: t.sources, granularity: t.granularity, visits: t.totals.visits}|json_encode(15)|raw }}</script>
            <div class="traffic-plot">
                <div class="traffic-chart-info" aria-live="polite"><strong data-traffic-title>Все источники</strong><span data-traffic-detail>{{ t.days == 1 ? 'Визиты по часам' : 'Визиты по дням' }} · МСК</span></div>
                <div class="traffic-chart-grid"><div class="traffic-axis" data-traffic-axis aria-hidden="true"></div><div class="traffic-chart-scroll"><div class="traffic-bars" data-traffic-bars role="group" aria-label="Визиты по источникам"></div></div></div>
            </div>
            <div class="traffic-source-list" data-traffic-sources aria-label="Фильтр источника"></div>
        </section>
        {% if t.sources is empty %}
            <p class="muted">За выбранный период визитов пока нет.</p>
        {% else %}
            <div class="dashboard-table-scroll" tabindex="0" role="region" aria-label="Таблица статистики — прокрутка по горизонтали"><table>
                <thead><tr><th>Источник</th><th class="num">Браузеры / визиты</th><th class="num">Скачивания</th><th class="num">Установки</th><th class="num">Визит → скачивание</th></tr></thead>
                {% for row in t.sources %}
                    <tr>
                        <td data-label="Источник">{{ row.label }}</td>
                        <td class="num" data-label="Браузеры / визиты">{{ row.visitors }} / {{ row.visits }}</td>
                        <td class="num" data-label="Скачивания">{{ row.downloads }}</td>
                        <td class="num" data-label="Установки">{{ row.installs }}</td>
                        <td class="num muted" data-label="Конверсия">{{ row.visits > 0 ? (row.convertedVisits / row.visits * 100)|round(1) ~ '%' : '—' }}</td>
                    </tr>
                {% endfor %}
            </table></div>
        {% endif %}
    </div>

    <div class="panel-grid panel-grid-equal">
        <div class="panel">
            <h3>Сайты, с которых перешли</h3>
            {% if t.referrers is empty %}<p class="muted">Пока нет.</p>{% else %}
                <div class="dashboard-table-scroll" tabindex="0" role="region" aria-label="Таблица статистики — прокрутка по горизонтали"><table>{% for row in t.referrers %}<tr><td>{{ row.host }} <span class="muted">· {{ row.label }}</span></td><td class="num">{{ row.visits }}</td></tr>{% endfor %}</table></div>
            {% endif %}
        </div>
        <div class="panel">
            <h3>Страницы входа <span class="muted">(визиты / скачивания)</span></h3>
            {% if t.landings is empty %}<p class="muted">Пока нет.</p>{% else %}
                <div class="dashboard-table-scroll" tabindex="0" role="region" aria-label="Таблица статистики — прокрутка по горизонтали"><table>{% for row in t.landings %}<tr><td>{{ row.path }}</td><td class="num">{{ row.visits }} / {{ row.downloads }}</td></tr>{% endfor %}</table></div>
            {% endif %}
        </div>
        <div class="panel">
            <h3>Метки ссылок <span class="muted">(utm / ref: визиты / скачивания)</span></h3>
            {% if t.campaigns is empty %}<p class="muted">Ссылок с метками ещё не открывали.</p>{% else %}
                <div class="dashboard-table-scroll" tabindex="0" role="region" aria-label="Таблица статистики — прокрутка по горизонтали"><table>{% for row in t.campaigns %}<tr><td>{{ row.campaign }}</td><td class="num">{{ row.visits }} / {{ row.downloads }}</td></tr>{% endfor %}</table></div>
            {% endif %}
        </div>
        <div class="panel">
            <h3>Последние скачивания</h3>
            {% if t.recentDownloads is empty %}<p class="muted">Пока нет.</p>{% else %}
                <div class="dashboard-table-scroll" tabindex="0" role="region" aria-label="Таблица статистики — прокрутка по горизонтали"><table>{% for row in t.recentDownloads %}
                    <tr>
                        <td class="muted" style="white-space:nowrap">{{ row.created_at|date('d.m H:i') }}</td>
                        <td>{{ row.label }}</td>
                        <td class="muted">{{ row.landing_path }}{% if row.referrer %} · {{ row.referrer|replace({'https://': '', 'http://': ''})|slice(0, 40) }}{% endif %}{% if row.utm_source %} · {{ row.utm_source }}{% endif %}</td>
                    </tr>
                {% endfor %}</table></div>
            {% endif %}
        </div>
    </div>

    <div class="panel-grid">
        <div class="panel">
            <h3>За 30 дней</h3>
            <div class="dashboard-chart"><canvas id="dailyChart" height="120"></canvas></div>
        </div>
        <div class="panel">
            <h3>Версии лаунчера <span class="muted">(активные за 30 дней)</span></h3>
            {% if versions is empty %}
                <p class="muted">Данных пока нет.</p>
            {% else %}
                <div class="dashboard-table-scroll" tabindex="0" role="region" aria-label="Таблица статистики — прокрутка по горизонтали"><table>
                    {% for row in versions %}
                        <tr><td>{{ row.version }}</td><td class="num">{{ row.installs }}</td></tr>
                    {% endfor %}
                </table></div>
            {% endif %}
        </div>
    </div>

    <div class="panel">
        <h3>Популярные серверы <span class="muted">(нажатия «Играть» за 7 дней)</span></h3>
        {% if topServers is empty %}
            <p class="muted">Пока никто не запускал игру через лаунчер.</p>
        {% else %}
            <div class="dashboard-table-scroll" tabindex="0" role="region" aria-label="Таблица статистики — прокрутка по горизонтали"><table class="stats-servers">
                <thead><tr><th>Сервер</th><th>Адрес</th><th class="num">Нажатий</th><th class="num">Уникальных IP</th></tr></thead>
                {% for row in topServers %}
                    <tr>
                        <td data-label="Сервер">{{ row.serverName }}</td>
                        <td class="muted" data-label="Адрес">{{ row.serverAddress }}</td>
                        <td class="num" data-label="Нажатий">{{ row.plays }}</td>
                        <td class="num" data-label="Уникальных IP">{{ row.players }}</td>
                    </tr>
                {% endfor %}
            </table></div>
        {% endif %}
    </div>

    <script src="{{ asset('admin/traffic-chart.js') }}" defer></script>
    <script src="{{ asset('js/chart.umd.min.js') }}"></script>
    <script>
        (function () {
            const daily = {{ daily|json_encode|raw }};
            const styles = getComputedStyle(document.body);
            const textColor = styles.getPropertyValue('--text-muted').trim() || '#6c757d';
            const gridColor = styles.getPropertyValue('--border-color').trim() || '#e3e7ed';
            const labels = daily.map((d) => d.day.slice(8, 10) + '.' + d.day.slice(5, 7));
            new Chart(document.getElementById('dailyChart'), {
                type: 'line',
                data: {
                    labels,
                    datasets: [
                        { label: 'Уникальные IP', data: daily.map((d) => d.uniqueIps), borderColor: '#7c3aed', backgroundColor: '#7c3aed22', fill: true, tension: 0.3 },
                        { label: 'Нажатия «Играть»', data: daily.map((d) => d.plays), borderColor: '#f59e0b', backgroundColor: '#f59e0b22', fill: false, tension: 0.3 }
                    ]
                },
                options: {
                    maintainAspectRatio: false,
                    responsive: true,
                    color: textColor,
                    interaction: { mode: 'index', intersect: false },
                    scales: {
                        x: { ticks: { color: textColor }, grid: { color: gridColor } },
                        y: { beginAtZero: true, ticks: { precision: 0, color: textColor }, grid: { color: gridColor } }
                    }
                }
            });

        })();
    </script>
{% endblock %}
