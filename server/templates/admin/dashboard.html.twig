{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Статистика лаунчера{% endblock %}

{% block main %}
    <style>
        /* Цвета — из переменных темы EasyAdmin, чтобы работали и светлая, и тёмная тема. */
        .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
        .stat-card, .panel { padding: 18px 20px; border-radius: 10px; border: 1px solid var(--border-color); background: var(--form-control-bg); color: var(--text-color); }
        .stat-card .value { font-size: 32px; font-weight: 700; line-height: 1.1; }
        .stat-card .label { margin-top: 6px; color: var(--text-muted); font-size: 13px; }
        .stat-card.online .value { color: #16a34a; }
        .panel-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 16px; margin-bottom: 24px; }
        @media (max-width: 1100px) { .panel-grid { grid-template-columns: 1fr; } }
        .panel h3 { font-size: 15px; margin: 0 0 14px; color: var(--text-color); }
        .panel table { width: 100%; font-size: 13px; color: var(--text-color); }
        .panel td, .panel th { padding: 6px 4px; border-bottom: 1px solid var(--border-color); }
        .panel th { color: var(--text-muted); font-weight: 600; }
        .panel td.num, .panel th.num { text-align: right; white-space: nowrap; }
        .muted { color: var(--text-muted); }
    </style>

    <div class="stat-grid">
        <div class="stat-card online">
            <div class="value">{{ onlineNow }}</div>
            <div class="label">Онлайн сейчас (за {{ onlineWindow }} мин)</div>
        </div>
        <div class="stat-card">
            <div class="value">{{ uniqueIpsToday }}</div>
            <div class="label">Уникальных IP сегодня</div>
        </div>
        <div class="stat-card">
            <div class="value">{{ playsToday }}</div>
            <div class="label">Нажатий «Играть» сегодня</div>
        </div>
        <div class="stat-card">
            <div class="value">{{ totalInstalls }}</div>
            <div class="label">Установок всего</div>
        </div>
    </div>

    {% set t = traffic %}
    <div class="panel traffic" id="traffic">
        <h3>Откуда приходят
            <span class="muted">
                {% for d, label in {1: 'сегодня', 7: '7 дней', 30: '30 дней', 90: '90 дней', 365: 'год'} %}
                    {% if t.days == d %}<b>{{ label }}</b>{% else %}<a href="?days={{ d }}#traffic">{{ label }}</a>{% endif %}{% if not loop.last %} · {% endif %}
                {% endfor %}
            </span>
        </h3>
        <div class="stat-grid">
            <div class="stat-card"><div class="value">{{ t.totals.visits }}</div><div class="label">Визитов на сайт</div></div>
            <div class="stat-card"><div class="value">{{ t.totals.downloads }}</div><div class="label">Скачиваний из браузера{% if t.totals.visits > 0 %} · {{ (t.totals.downloads / t.totals.visits * 100)|round(1) }}% от визитов{% endif %}</div></div>
            <div class="stat-card"><div class="value">{{ t.totals.installs }}</div><div class="label">Новых установок</div></div>
            <div class="stat-card"><div class="value">{{ t.totals.installsUnknown }}</div><div class="label">Установок без источника{% if t.trackingSince %} · учёт с {{ t.trackingSince|date('d.m.Y') }}{% endif %}</div></div>
        </div>

        {% if t.sources is empty %}
            <p class="muted">Данных пока нет — учёт начнётся с первых заходов.</p>
        {% else %}
            <table>
                <thead><tr><th>Источник</th><th class="num">Визиты</th><th class="num">Скачивания</th><th class="num">Установки</th><th class="num">Визит → скачивание</th></tr></thead>
                {% for row in t.sources %}
                    <tr>
                        <td data-label="Источник">{{ row.label }}</td>
                        <td class="num" data-label="Визиты">{{ row.visits }}</td>
                        <td class="num" data-label="Скачивания">{{ row.downloads }}</td>
                        <td class="num" data-label="Установки">{{ row.installs }}</td>
                        <td class="num muted" data-label="Конверсия">{{ row.visits > 0 ? (row.downloads / row.visits * 100)|round(1) ~ '%' : '—' }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}
        <p class="muted" style="margin-top:10px;font-size:12px">Установка относится к скачиванию с того же IP за 48 часов до первого запуска. Свою метку можно дать ссылке: <code>?ref=steam</code> или <code>utm_source</code>.</p>
    </div>

    <div class="panel-grid" style="grid-template-columns:1fr 1fr">
        <div class="panel">
            <h3>Сайты, с которых перешли</h3>
            {% if t.referrers is empty %}<p class="muted">Пока нет.</p>{% else %}
                <table>{% for row in t.referrers %}<tr><td>{{ row.host }} <span class="muted">· {{ row.label }}</span></td><td class="num">{{ row.visits }}</td></tr>{% endfor %}</table>
            {% endif %}
        </div>
        <div class="panel">
            <h3>Страницы входа <span class="muted">(визиты / скачивания)</span></h3>
            {% if t.landings is empty %}<p class="muted">Пока нет.</p>{% else %}
                <table>{% for row in t.landings %}<tr><td>{{ row.path }}</td><td class="num">{{ row.visits }} / {{ row.downloads }}</td></tr>{% endfor %}</table>
            {% endif %}
        </div>
        <div class="panel">
            <h3>Метки ссылок <span class="muted">(utm / ref: визиты / скачивания)</span></h3>
            {% if t.campaigns is empty %}<p class="muted">Ссылок с метками ещё не открывали.</p>{% else %}
                <table>{% for row in t.campaigns %}<tr><td>{{ row.campaign }}</td><td class="num">{{ row.visits }} / {{ row.downloads }}</td></tr>{% endfor %}</table>
            {% endif %}
        </div>
        <div class="panel">
            <h3>Последние скачивания</h3>
            {% if t.recentDownloads is empty %}<p class="muted">Пока нет.</p>{% else %}
                <table>{% for row in t.recentDownloads %}
                    <tr>
                        <td class="muted" style="white-space:nowrap">{{ row.created_at|date('d.m H:i') }}</td>
                        <td>{{ row.label }}</td>
                        <td class="muted">{{ row.landing_path }}{% if row.referrer %} · {{ row.referrer|replace({'https://': '', 'http://': ''})|slice(0, 40) }}{% endif %}{% if row.utm_source %} · {{ row.utm_source }}{% endif %}</td>
                    </tr>
                {% endfor %}</table>
            {% endif %}
        </div>
    </div>

    <div class="panel" style="margin-bottom:24px">
        <h3>Визиты, скачивания и установки по дням</h3>
        <canvas id="trafficChart" height="90"></canvas>
    </div>

    <div class="panel-grid">
        <div class="panel">
            <h3>За 30 дней</h3>
            <canvas id="dailyChart" height="120"></canvas>
        </div>
        <div class="panel">
            <h3>Версии лаунчера <span class="muted">(активные за 30 дней)</span></h3>
            {% if versions is empty %}
                <p class="muted">Данных пока нет.</p>
            {% else %}
                <table>
                    {% for row in versions %}
                        <tr><td>{{ row.version }}</td><td class="num">{{ row.installs }}</td></tr>
                    {% endfor %}
                </table>
            {% endif %}
        </div>
    </div>

    <div class="panel">
        <h3>Популярные серверы <span class="muted">(нажатия «Играть» за 7 дней)</span></h3>
        {% if topServers is empty %}
            <p class="muted">Пока никто не запускал игру через лаунчер.</p>
        {% else %}
            <table class="stats-servers">
                <thead><tr><th>Сервер</th><th>Адрес</th><th class="num">Нажатий</th><th class="num">Уникальных IP</th></tr></thead>
                {% for row in topServers %}
                    <tr>
                        <td data-label="Сервер">{{ row.serverName }}</td>
                        <td class="muted" data-label="Адрес">{{ row.serverAddress }}</td>
                        <td class="num" data-label="Нажатий">{{ row.plays }}</td>
                        <td class="num" data-label="Уникальных IP">{{ row.players }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}
    </div>

    <script src="{{ asset('js/chart.umd.min.js') }}"></script>
    <script>
        (function () {
            const daily = {{ daily|json_encode|raw }};
            const styles = getComputedStyle(document.body);
            const textColor = styles.getPropertyValue('--text-muted').trim() || '#6c757d';
            const gridColor = styles.getPropertyValue('--border-color').trim() || '#e3e7ed';
            const labels = daily.map((d) => d.day.slice(8, 10) + '.' + d.day.slice(5, 7));
            new Chart(document.getElementById('dailyChart'), {
                type: 'line',
                data: {
                    labels,
                    datasets: [
                        { label: 'Уникальные IP', data: daily.map((d) => d.uniqueIps), borderColor: '#7c3aed', backgroundColor: '#7c3aed22', fill: true, tension: 0.3 },
                        { label: 'Нажатия «Играть»', data: daily.map((d) => d.plays), borderColor: '#f59e0b', backgroundColor: '#f59e0b22', fill: false, tension: 0.3 }
                    ]
                },
                options: {
                    color: textColor,
                    interaction: { mode: 'index', intersect: false },
                    scales: {
                        x: { ticks: { color: textColor }, grid: { color: gridColor } },
                        y: { beginAtZero: true, ticks: { precision: 0, color: textColor }, grid: { color: gridColor } }
                    }
                }
            });

            const traffic = {{ traffic.daily|json_encode|raw }};
            new Chart(document.getElementById('trafficChart'), {
                type: 'bar',
                data: {
                    labels: traffic.map((d) => d.day.slice(8, 10) + '.' + d.day.slice(5, 7)),
                    datasets: [
                        { label: 'Визиты', data: traffic.map((d) => d.visits), backgroundColor: '#7c3aed55' },
                        { label: 'Скачивания', data: traffic.map((d) => d.downloads), backgroundColor: '#f59e0b' },
                        { label: 'Установки', data: traffic.map((d) => d.installs), backgroundColor: '#16a34a' }
                    ]
                },
                options: {
                    color: textColor,
                    interaction: { mode: 'index', intersect: false },
                    scales: {
                        x: { ticks: { color: textColor }, grid: { color: gridColor } },
                        y: { beginAtZero: true, ticks: { precision: 0, color: textColor }, grid: { color: gridColor } }
                    }
                }
            });
        })();
    </script>
{% endblock %}
