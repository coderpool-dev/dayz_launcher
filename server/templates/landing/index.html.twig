{%- set version = release ? release.version : null -%}
{%- set size = release ? (release.fileSize / 1048576)|number_format(1, ',', ' ') : null -%}
{%- set base = app.request.basePath -%}
{#- Число с пробелами между разрядами, которое не разрывается переносом строки. -#}
{%- macro num(n) -%}<span class="num">{{ n|number_format(0, ',', ' ') }}</span>{%- endmacro -%}
{#- Русское множественное число: plural(5, 'сервер', 'сервера', 'серверов') → «серверов». -#}
{%- macro plural(n, one, few, many) -%}
    {%- set n10 = n % 10 -%}
    {%- set n100 = n % 100 -%}
    {{- n10 == 1 and n100 != 11 ? one : (n10 >= 2 and n10 <= 4 and (n100 < 12 or n100 > 14) ? few : many) -}}
{%- endmacro -%}
{%- from _self import num, plural -%}
<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PREPISKA DayZ Launcher — лаунчер DayZ с автоматической установкой модов</title>
    <meta name="description" content="Бесплатный лаунчер DayZ для Windows: весь каталог серверов DZSA по онлайну, моды сервера скачиваются из Steam Workshop сами, бег в наклоне на Q/E.">
    <meta property="og:title" content="PREPISKA DayZ Launcher">
    <meta property="og:description" content="Лаунчер DayZ для Windows: сам скачивает моды сервера из Steam Workshop и подключает к игре.">
    <meta property="og:image" content="{{ absolute_url(asset('landing/img/home.jpg')) }}">
    <meta property="og:type" content="website">
    <meta name="theme-color" content="#141414">
    <link rel="icon" href="{{ asset('favicon.ico') }}">
    {# Без asset(): стили берут шрифты по адресу без версии, и предзагрузка должна совпасть с ним. #}
    <link rel="preload" href="{{ base }}/landing/fonts/oswald-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ base }}/landing/fonts/inter-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ asset('landing/landing.css') }}">
    <script src="{{ asset('landing/landing.js') }}" defer></script>
</head>
<body>
    <header class="topbar">
        <div class="container topbar-inner">
            <a class="logo" href="{{ path('landing') }}" aria-label="PREPISKA DayZ Launcher">
                <img class="logo-mark" src="{{ asset('landing/img/logo.png') }}" width="44" height="44" alt="" />
                <span class="logo-type">
                    <span class="logo-title">PREPISKA</span>
                    <span class="logo-subtitle">DAYZ LAUNCHER</span>
                </span>
            </a>
            <nav class="topnav" aria-label="Разделы">
                <a href="#compare">Отличия</a>
                <a href="#features">Возможности</a>
                <a href="#faq">Вопросы</a>
                <a href="#download">Установка</a>
            </nav>
            {% if release %}
                <a class="button button-outline button-small" href="{{ path('download_latest') }}">Скачать</a>
            {% endif %}
        </div>
    </header>

    <main>
        <section class="hero">
            <div class="container grid">
                <h1>Все серверы DayZ с&nbsp;модами в&nbsp;одном лаунчере</h1>
                <div class="hero-side">
                    <p class="lead">В стандартном лаунчере список забит рекламными серверами, а серверов с модами мало. Здесь весь каталог DZSA, моды скачиваются сами, а в наклоне можно бежать на Q/E.</p>
                    {% if release %}
                        <a class="button button-primary button-large" href="{{ path('download_latest') }}">Скачать для Windows</a>
                    {% else %}
                        <span class="button button-primary button-large is-disabled">Скоро будет доступен</span>
                    {% endif %}
                    <p class="hero-meta">{% if release %}Версия {{ version }} · {{ size }}&nbsp;МБ · {% endif %}Windows 10/11 · бесплатно</p>
                </div>
            </div>
            <div class="container">
                <a class="shot-link hero-shot" href="{{ asset('landing/img/home.jpg') }}">
                    <img class="shot" src="{{ asset('landing/img/home.jpg') }}" width="1280" height="720" fetchpriority="high" alt="Главный экран лаунчера: выбранный сервер и кнопка «Играть»">
                </a>
            </div>
        </section>

        {% if stats %}
            {%- set headline = stats.modded ?? stats.servers -%}
            <section class="now" aria-label="Сейчас в каталоге DZSA">
                <div class="container">
                    <div class="grid now-head">
                        <p class="now-number">{{ num(headline) }}</p>
                        <div class="now-caption">
                            <p class="live-stats">
                                {%- if stats.modded is defined -%}
                                    {{ plural(headline, 'сервер', 'сервера', 'серверов') }} с модами в каталоге DZSA прямо сейчас. Всего в каталоге {{ num(stats.servers) }} {{ plural(stats.servers, 'сервер', 'сервера', 'серверов') }},
                                {%- else -%}
                                    {{ plural(headline, 'сервер', 'сервера', 'серверов') }} в каталоге DZSA прямо сейчас,
                                {%- endif %}
                                на них {{ plural(stats.players, 'играет', 'играют', 'играют') }} {{ num(stats.players) }} {{ plural(stats.players, 'человек', 'человека', 'человек') }}.
                            </p>
                            {% if stats.updatedAt is defined %}
                                <p class="now-note">Данные на {{ stats.updatedAt|date(('now'|date('U') - stats.updatedAt) < 86400 ? 'H:i' : 'd.m.Y H:i', 'Europe/Moscow') }} МСК</p>
                            {% endif %}
                        </div>
                    </div>

                    {% if stats.top is defined and stats.top is not empty %}
                        {# Самые населённые серверы с модами из ежеминутного снимка (ServerListPublisher).
                           Строки таблиц — сетки по осям страницы, поэтому роли таблицы заданы явно. #}
                        <h3 class="top-title" id="top-title">Больше всего игроков сейчас <span>серверы с модами, без спонсоров</span></h3>
                        <table class="top" role="table" aria-labelledby="top-title">
                            <thead role="rowgroup">
                                <tr role="row">
                                    <th role="columnheader" scope="col"><span class="visually-hidden">Место</span></th>
                                    <th role="columnheader" scope="col">Сервер</th>
                                    <th role="columnheader" scope="col">Карта</th>
                                    <th role="columnheader" scope="col" class="top-n">Игроки</th>
                                    <th role="columnheader" scope="col" class="top-n">Моды</th>
                                </tr>
                            </thead>
                            <tbody role="rowgroup">
                                {% for server in stats.top %}
                                    <tr role="row">
                                        <td role="cell" class="top-rank">{{ loop.index }}</td>
                                        <td role="cell" class="top-name" title="{{ server.fullName ?? server.name }}">{{ server.name }}</td>
                                        <td role="cell" class="top-map">{{ server.map }}</td>
                                        <td role="cell" class="top-n" data-label="Игроки">{{ server.players }}/{{ server.maxPlayers }}</td>
                                        <td role="cell" class="top-n" data-label="Моды">{{ server.mods }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>
            </section>
        {% endif %}

        <section class="section" id="compare">
            <div class="container">
                <h2>Чем отличается от стандартного лаунчера</h2>
                <table class="compare" role="table">
                    <thead role="rowgroup">
                        <tr role="row">
                            <td role="cell"></td>
                            <th role="columnheader" scope="col">Стандартный лаунчер DayZ</th>
                            <th role="columnheader" scope="col">PREPISKA DayZ Launcher</th>
                        </tr>
                    </thead>
                    <tbody role="rowgroup">
                        <tr role="row">
                            <th role="rowheader" scope="row">Порядок списка</th>
                            <td role="cell" data-label="Стандартный">Сверху рекламные серверы</td>
                            <td role="cell" data-label="PREPISKA">По онлайну, сверху спонсоры с пометкой «Реклама»</td>
                        </tr>
                        <tr role="row">
                            <th role="rowheader" scope="row">Серверы с модами</th>
                            <td role="cell" data-label="Стандартный">Их мало, приходится искать</td>
                            <td role="cell" data-label="PREPISKA">Весь каталог DZSA, почти все серверы в нём с модами</td>
                        </tr>
                        <tr role="row">
                            <th role="rowheader" scope="row">Бег в наклоне</th>
                            <td role="cell" data-label="Стандартный">С клавиатуры не работает</td>
                            <td role="cell" data-label="PREPISKA">На Q/E</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="section" id="features">
            <div class="container">
                <h2>Возможности</h2>
                {# На широком экране скриншот один, справа; выбранный пункт обведён, как выбранный сервер в лаунчере. #}
                <div class="tour" data-tour>
                    <div class="tour-item is-active">
                        <div class="tour-text">
                            <h3><button class="tour-tab" type="button" aria-controls="feature-servers">Список серверов</button></h3>
                            <p>Весь каталог DZSA. Сначала спонсоры с пометкой «Реклама», дальше серверы по онлайну, рекламные места DZSA не учитываются. Пустые серверы и подделки-«зеркала» скрыты, поиск по названию и адресу понимает опечатки.</p>
                        </div>
                        <a class="shot-link tour-shot" id="feature-servers" href="{{ asset('landing/img/servers.jpg') }}">
                            <img class="shot" src="{{ asset('landing/img/servers.jpg') }}" width="1280" height="720" loading="lazy" alt="Список серверов с поиском, спонсорский сервер помечен «Реклама»">
                        </a>
                    </div>
                    <div class="tour-item">
                        <div class="tour-text">
                            <h3><button class="tour-tab" type="button" aria-controls="feature-mods">Моды скачиваются сами</button></h3>
                            <p>Перед запуском лаунчер проверяет моды сервера, подписывается на недостающие в Steam Workshop и ждёт загрузки. В каком бы порядке сервер ни перечислил моды, CF и другие базовые лаунчер подключает первыми.</p>
                        </div>
                        <a class="shot-link tour-shot" id="feature-mods" href="{{ asset('landing/img/mods.jpg') }}">
                            <img class="shot" src="{{ asset('landing/img/mods.jpg') }}" width="1280" height="720" loading="lazy" alt="Моды сервера и скачанные моды">
                        </a>
                    </div>
                    <div class="tour-item">
                        <div class="tour-text">
                            <h3><button class="tour-tab" type="button" aria-controls="feature-lean">Бег в наклоне на Q/E</button></h3>
                            <p>Лаунчер назначает на Q и E наклон из раскладки геймпада, и с ним можно бежать, не выходя из наклона. Модель смещается в сторону, поэтому в вас труднее попасть. Включается в настройках.</p>
                        </div>
                        <a class="shot-link tour-shot" id="feature-lean" href="{{ asset('landing/img/settings.jpg') }}">
                            <img class="shot" src="{{ asset('landing/img/settings.jpg') }}" width="1280" height="720" loading="lazy" alt="Настройки лаунчера: включён бег в наклоне на Q/E">
                        </a>
                    </div>
                    <div class="tour-item">
                        <div class="tour-text">
                            <h3><button class="tour-tab" type="button" aria-controls="feature-favorites">Избранные серверы</button></h3>
                            <p>Отмечайте серверы звёздочкой, чтобы быстро найти их при следующем запуске.</p>
                        </div>
                        <a class="shot-link tour-shot" id="feature-favorites" href="{{ asset('landing/img/favorites.jpg') }}">
                            <img class="shot" src="{{ asset('landing/img/favorites.jpg') }}" width="1280" height="720" loading="lazy" alt="Избранные серверы в новом серо-белом интерфейсе">
                        </a>
                    </div>
                    <div class="tour-item">
                        <div class="tour-text">
                            <h3><button class="tour-tab" type="button" aria-controls="feature-history">История запусков</button></h3>
                            <p>Серверы можно добавить в избранное, последние 50 запусков сохраняются в истории. Ник берётся из профиля Steam, скачанные моды можно посмотреть и удалить.</p>
                        </div>
                        <a class="shot-link tour-shot" id="feature-history" href="{{ asset('landing/img/history.jpg') }}">
                            <img class="shot" src="{{ asset('landing/img/history.jpg') }}" width="1280" height="720" loading="lazy" alt="История запусков">
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section class="section" id="faq">
            <div class="container grid">
                <h2>Частые вопросы</h2>
                <div class="faq-list">
                    <details>
                        <summary>Где лаунчер берёт моды?</summary>
                        <p>Из Steam Workshop через ваш аккаунт Steam, так же, как если бы вы подписались на моды вручную. Лаунчер только подписывается на нужные моды и ждёт, пока Steam их скачает.</p>
                    </details>
                    <details>
                        <summary>Как обновлять лаунчер?</summary>
                        <p>Он обновляется сам: когда выходит новая версия, лаунчер предлагает обновиться, скачивает её, проверяет контрольную сумму и перезапускается. Можно и вручную: скачайте установщик с этой страницы и запустите поверх.</p>
                    </details>
                    <details>
                        <summary>Как удалить?</summary>
                        <p>Через «Параметры → Приложения», как любую программу. Скачанные моды останутся в Steam. Их можно удалить в разделе «Моды» лаунчера до удаления или в самом Steam.</p>
                    </details>
                </div>
            </div>
        </section>

        <section class="section" id="download">
            <div class="container grid">
                <h2>Установка</h2>
                <div class="download-main">
                    {% if release %}
                        <a class="button button-primary button-large" href="{{ path('download_latest') }}">Скачать PREPISKA DayZ Launcher</a>
                        <p class="cta-meta">Версия {{ version }} от {{ release.createdAt|date('d.m.Y') }} · {{ size }}&nbsp;МБ · Windows 10/11</p>
                    {% else %}
                        <span class="button button-primary button-large is-disabled">Скоро будет доступен</span>
                    {% endif %}
                    <ol class="steps">
                        <li>Запустите установщик. Права администратора не нужны, а .NET 8 и WebView2, если их нет, он сам скачает с сайта Microsoft.</li>
                        <li>Если Windows напишет «Система Windows защитила ваш компьютер», нажмите «Подробнее», затем «Выполнить в любом случае». Так SmartScreen встречает программы без цифровой подписи.</li>
                        <li>Запустите Steam: через него лаунчер берёт ник и скачивает моды. DayZ должна быть установлена.</li>
                    </ol>
                    {% if release %}
                        <p class="checksum">SHA-256 установщика: <code>{{ release.sha256 }}</code></p>
                    {% endif %}
                </div>
            </div>
        </section>
    </main>

    <footer class="footer">
        <div class="container footer-inner">
            <span>© {{ 'now'|date('Y') }} PREPISKA</span>
            <span>DayZ — товарный знак Bohemia Interactive. Проект не связан с Bohemia Interactive и Valve.</span>
        </div>
    </footer>
</body>
</html>
