{% extends 'landing/index.html.twig' %}

{% block title %}{{ 'Сервер не найден — мониторинг DayZ'|trans }}{% endblock %}
{% block description %}{{ 'Сервер выключен или давно пустует. Найдите другой сервер DayZ в мониторинге.'|trans }}{% endblock %}
{% block robots %}noindex, follow{% endblock %}
{% block structured_data %}{% endblock %}
{% block page_assets %}
    <link rel="stylesheet" href="{{ asset('landing/monitoring.css') }}">
{% endblock %}

{% block content %}
<section class="monitor container">
    <h1>{{ 'Сервер не найден'|trans }}</h1>
    <p class="monitor-intro">{{ 'Сервер выключен или давно пустует, поэтому его нет в списке. Найдите другой в'|trans }} <a href="{{ path('monitoring') }}">{{ 'мониторинге серверов DayZ'|trans }}</a>.</p>
</section>
{% endblock %}
