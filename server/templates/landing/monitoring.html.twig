{% extends 'landing/index.html.twig' %}

{% block title %}{{ 'Мониторинг серверов DayZ — онлайн, IP, карты, PvE и PvP'|trans }}{% if listingPage > 1 %} — {{ 'Страница '|trans }}{{ listingPage }}{% endif %}{% endblock %}
{% block description %}{{ 'Найдите сервер DayZ: онлайн игроков, IP и порт, карты, моды и история активности. Мониторинг серверов дейз с фильтрами PvE, PvP, 1PP и поиском по названию.'|trans }}{% endblock %}
{% block structured_data %}
    {% set items = [] %}
    {% for server in servers %}
        {% set items = items|merge([{'@type': 'ListItem', 'position': (listingPage - 1) * listingPageSize + loop.index, 'name': server.name, 'url': 'https://prepiskadayz.ru' ~ path('monitoring_server', {slug: server.slug})}]) %}
    {% endfor %}
    <script type="application/ld+json">{{ {
        '@context': 'https://schema.org',
        '@graph': [
            {'@type': 'BreadcrumbList', 'itemListElement': [
                {'@type': 'ListItem', 'position': 1, 'name': 'PREPISKA DayZ Launcher', 'item': 'https://prepiskadayz.ru/'},
                {'@type': 'ListItem', 'position': 2, 'name': ('Мониторинг серверов DayZ'|trans), 'item': canonical}
            ]},
            {'@type': 'CollectionPage', 'name': page_title|trim, 'url': canonical, 'inLanguage': app.request.locale,
                'description': page_description|trim, 'mainEntity': {'@type': 'ItemList', 'itemListElement': items}}
        ]
    }|json_encode(15)|raw }}</script>
{% endblock %}
{% block page_assets %}
    <link rel="stylesheet" href="{{ asset('landing/monitoring.css') }}">
    <script src="{{ asset('landing/monitoring-i18n.js') }}" defer></script>
    <script src="{{ asset('landing/monitoring.js') }}" defer></script>
{% endblock %}

{% block content %}
<section class="monitor container" data-monitor data-listing-page="{{ listingPage }}" data-page-size="{{ listingPageSize }}" data-api="{{ path('api_monitoring') }}" data-history-api="{{ path('api_monitoring_history') }}">
    <div class="monitor-heading">
        <div><p class="monitor-eyebrow">{{ 'DAYZ / СЕРВЕРЫ'|trans }}</p><h1>{{ 'Мониторинг серверов DayZ'|trans }}</h1></div>
        <button class="button button-outline" type="button" data-refresh>{{ 'Обновить'|trans }}</button>
    </div>
    <p class="monitor-intro">{{ 'Онлайн игроков, IP и порты, карты и моды серверов DayZ. Найдите сервер под своё время игры и подключитесь.'|trans }}</p>
    <nav class="monitor-shortcuts" aria-label="{{ 'Быстрый выбор серверов'|trans }}">
        <a href="{{ path('monitoring_mode', {mode: 'pve'}) }}">{{ 'PvE серверы DayZ'|trans }}</a>
        <a href="{{ path('monitoring_mode', {mode: 'pvp'}) }}">{{ 'PvP серверы DayZ'|trans }}</a>
        <a href="{{ path('monitoring_mode', {mode: 'vanilla'}) }}">{{ 'Серверы DayZ без модов'|trans }}</a>
        <a href="{{ path('monitoring_mode', {mode: 'modded'}) }}">{{ 'Серверы DayZ с модами'|trans }}</a>
        <a href="#server-maps">{{ 'Выбрать карту'|trans }} ↓</a>
    </nav>
    <form class="monitor-filters" role="search">
        <label class="monitor-search">{{ 'Поиск серверов'|trans }}
            <input type="search" name="q" placeholder="{{ 'Название, IP:порт, карта или мод'|trans }}" autocomplete="off">
        </label>
        <details class="monitor-parameters">
            <summary>{{ 'Параметры'|trans }}</summary>
            <div class="monitor-facets">
                <label>{{ 'Страна'|trans }}<select name="country"><option value="all" selected>{{ 'Все страны'|trans }}</option><option value="RU">{{ 'Россия'|trans }}</option></select></label>
                <label>{{ 'Карта'|trans }}<select name="map"><option value="">{{ 'Все карты'|trans }}</option></select></label>
                <label>{{ 'Версия'|trans }}<select name="version"><option value="">{{ 'Все версии'|trans }}</option></select></label>
                <label>{{ 'Вид'|trans }}<select name="perspective"><option value="">{{ 'Любой'|trans }}</option><option value="1pp">{{ 'Только 1PP'|trans }}</option><option value="3pp">1PP / 3PP</option></select></label>
                <label>{{ 'Сортировка'|trans }}<select name="sort"><option value="players">{{ 'По онлайну'|trans }}</option><option value="name">{{ 'По названию'|trans }}</option><option value="slots">{{ 'По свободным местам'|trans }}</option></select></label>
                <label>{{ 'Подборка'|trans }}<select name="collection"><option value="all" selected>{{ 'Сейчас онлайн'|trans }}</option><option value="stable">{{ 'Стабильный онлайн'|trans }}</option><option value="night">{{ 'Живёт ночью'|trans }}</option><option value="day">{{ 'Живёт днём'|trans }}</option></select></label>
                <label>{{ 'Режим'|trans }}<select name="mode"><option value="">{{ 'Любой'|trans }}</option><option value="deathmatch">Deathmatch</option><option value="pvp">PvP</option><option value="pve">PvE</option><option value="rp">Roleplay</option><option value="survival">Survival</option><option value="unknown">{{ 'Не указан'|trans }}</option></select></label>
                <label>{{ 'Модификации'|trans }}<select name="style"><option value="">{{ 'Любые'|trans }}</option><option value="vanilla">{{ 'Без модов'|trans }}</option><option value="vanilla-plus">Vanilla+</option><option value="modded">Modded</option></select></label>
                <div class="monitor-checks">
                    <label><input type="checkbox" name="populated"> {{ 'С игроками'|trans }}</label>
                    <label><input type="checkbox" name="modded"> {{ 'С модами'|trans }}</label>
                    <label><input type="checkbox" name="available"> {{ 'Без пароля и не заполнен'|trans }}</label>
                    <label><input type="checkbox" name="hardcore"> Hardcore</label>
                    <button class="monitor-reset" type="reset">{{ 'Сбросить'|trans }}</button>
                </div>
            </div>
        </details>
    </form>
    <p data-history-status class="server-meta" role="status" hidden></p>
    <div class="monitor-summary"><p data-count role="status" aria-live="polite">{{ 'Серверов:'|trans }} {{ totals.servers }} · {{ 'Игроков:'|trans }} {{ totals.players }}</p><p data-updated>{% if updatedAt %}{{ 'Данные на'|trans }} {{ updatedAt|date('d.m.Y H:i', 'Europe/Moscow') }} {{ 'МСК'|trans }}{% endif %}</p></div>
    <div data-message class="monitor-message" role="status" hidden></div>
    <noscript><p class="monitor-message">{{ 'Ниже показан сохранённый список серверов. Для поиска, фильтров и графиков включите JavaScript.'|trans }}</p></noscript>
    <table class="monitor-table" aria-label="{{ 'Серверы DayZ'|trans }}" aria-busy="false">
        <thead><tr><th scope="col">{{ 'Сервер / режим'|trans }}</th><th scope="col">{{ 'Карта / вид'|trans }}</th><th scope="col">{{ 'Игроки'|trans }}</th><th scope="col" data-metric-heading>{{ 'Средний онлайн'|trans }}</th><th scope="col">{{ 'Адрес'|trans }}</th></tr></thead>
        {#- Первая страница собрана на сервере для роботов без JavaScript; скрипт заменит её живым списком. -#}
        <tbody data-servers>{% include 'landing/_server_rows.html.twig' with {servers: servers} %}</tbody>
    </table>
    <nav class="monitor-pagination" aria-label="{{ 'Страницы серверов'|trans }}">
        {% set lang_params = app.request.locale == 'en' ? {lang: 'en'} : {} %}
        <a class="button button-outline" data-prev{% if listingPage > 1 %} href="{{ path('monitoring', lang_params|merge(listingPage > 2 ? {page: listingPage - 1} : {})) }}" rel="prev"{% else %} aria-disabled="true" tabindex="-1"{% endif %}>{{ 'Назад'|trans }}</a>
        <span data-page>{{ 'Страница '|trans }}{{ listingPage }}{{ ' из '|trans }}{{ listingPages }}</span>
        <a class="button button-outline" data-next{% if listingPage < listingPages %} href="{{ path('monitoring', lang_params|merge({page: listingPage + 1})) }}" rel="next"{% else %} aria-disabled="true" tabindex="-1"{% endif %}>{{ 'Далее'|trans }}</a>
    </nav>
    {% include 'landing/_collections.html.twig' %}
    <section class="monitor-help" aria-labelledby="monitor-help-title">
        <h2 id="monitor-help-title">{{ 'Как выбрать сервер DayZ'|trans }}</h2>
        <div>
            <h3>{{ 'Онлайн сейчас или активность за неделю?'|trans }}</h3>
            <p>{{ 'Число игроков показывает последний снимок, а не гарантию постоянного онлайна. В параметрах есть подборки «Живёт ночью», «Живёт днём» и «Стабильный онлайн»: они помогают выбрать сервер под ваше время игры. Время указано по Москве.'|trans }}</p>
            <h3>{{ 'PvE, PvP и карты'|trans }}</h3>
            <p>{{ 'Выберите карту и режим в параметрах или откройте отдельную подборку выше. Режим определяется по тегам названия; правила, рейды и вайпы проверяйте у администрации сервера.'|trans }}</p>
            <h3>{{ 'Как зайти по IP и установить моды?'|trans }}</h3>
            <p>{{ 'Скопируйте IP и игровой порт из списка. Для сервера без модов подойдёт прямое подключение DayZ. Для сервера с модами PREPISKA найдёт нужные подписки Steam Workshop и дождётся загрузки перед запуском.'|trans }} <a href="{{ path('landing') }}">{{ 'DayZ лаунчер без VPN в России'|trans }} →</a></p>
        </div>
    </section>
    <p class="visually-hidden" data-copy-status role="status" aria-live="polite"></p>
    <dialog class="monitor-history" data-history-dialog aria-labelledby="history-title">
        <div class="history-heading"><h2 id="history-title"></h2><button type="button" data-history-close aria-label="{{ 'Закрыть график'|trans }}" title="{{ 'Закрыть'|trans }}">×</button></div>
        <fieldset class="history-period"><legend class="visually-hidden">{{ 'Период графика'|trans }}</legend><label><input type="radio" name="period" value="1" checked> {{ 'Сутки'|trans }}</label><label><input type="radio" name="period" value="7"> {{ 'Неделя'|trans }}</label></fieldset>
        <p class="server-meta">{{ 'Среднее число игроков за час · МСК'|trans }}</p><div data-history-chart aria-live="polite"></div>
        <details><summary>{{ 'Замеры по часам'|trans }}</summary><div class="history-values" data-history-values></div></details>
    </dialog>
</section>
{% endblock %}
